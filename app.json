{
  "expo": {
    "name": "dawn",
    "slug": "dawn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/icon.png",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true
      },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
        }
      },

    "web": {
      "favicon": "./app/assets/favicon.png"
      },
      
    "plugins": [
      "expo-audio",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-splash-screen", {
        "image": "./app/assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}